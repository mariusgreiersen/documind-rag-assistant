# Copy to .env and adjust. Every value below is optional: the app starts without an
# LLM key and runs in retrieval-only mode (semantic search and source viewing work).

# --- Answer generation ---------------------------------------------------------
# anthropic | mock | none   (mock returns deterministic test answers; for development only)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Leave empty for retrieval-only mode. ANTHROPIC_API_KEY is also read if LLM_API_KEY is empty.
LLM_API_KEY=
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=90
# Re-run a request on Anthropic's recommended fallback model if a safety classifier declines it.
LLM_REFUSAL_FALLBACK=true

# --- Embeddings & chunking -----------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
# Must not exceed the model's input length (510 tokens for bge-small, 254 for all-MiniLM-L6-v2).
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
# Changing the model or chunking re-indexes stored documents automatically at the next startup.

# --- Retrieval -----------------------------------------------------------------
DEFAULT_TOP_K=5
# Cosine similarity below which no answer is generated. Model-specific: recalibrate with
# `python -m documind.evaluation.run` after changing EMBEDDING_MODEL.
MIN_RELEVANCE_SCORE=0.55

# --- Storage -------------------------------------------------------------------
# Defaults to ./data/runtime; CHROMA_PERSIST_DIR defaults to <DATA_DIR>/chroma.
# DATA_DIR=./data/runtime
# CHROMA_PERSIST_DIR=./data/runtime/chroma

# --- Limits --------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PAGES=50
MAX_DOCUMENTS=10

# --- Application ---------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Public demo deployments: disable uploads and deletions.
READ_ONLY=false
# Exposes retrieval scores, rewritten queries and timings in API responses.
ENABLE_DIAGNOSTICS=true
SEED_DEMO_ON_STARTUP=false
LOG_LEVEL=INFO
LOG_FORMAT=json
